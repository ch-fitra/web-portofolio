# Runtime roles: never use the migration superuser in the application.
DATABASE_URL=postgresql://portfolio_public:CHANGE_ME@127.0.0.1:5432/portfolio
OWNER_DATABASE_URL=postgresql://portfolio_owner:CHANGE_ME@127.0.0.1:5432/portfolio
AUTH_DATABASE_URL=postgresql://portfolio_auth:CHANGE_ME@127.0.0.1:5432/portfolio
# Used only by migration/provisioning commands. Remove from runtime deployment.
MIGRATION_DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/portfolio
SITE_URL=http://localhost:3000
MEDIA_ROOT=./storage/media
IP_HASH_SECRET=REPLACE_WITH_RANDOM_32_BYTES
# Set true ONLY behind a proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
# Optional server-owned email relay. HTTP 2xx must mean provider accepted delivery.
EMAIL_RELAY_URL=
EMAIL_RELAY_TOKEN=
NOTIFY_TO=
