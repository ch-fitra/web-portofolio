{
  "name": "ch-fitra-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*.test.mjs",
    "test:integration": "tsx --env-file=.env.local --test tests/integration/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "db:seed": "node --env-file=.env.local scripts/seed.mjs",
    "skills:import": "node --env-file=.env.local scripts/import-tech-stack.mjs",
    "projects:import-linkedin": "node --env-file=.env.local scripts/import-linkedin-projects.mjs",
    "owner:setup": "node --env-file=.env.local scripts/owner.mjs",
    "db:local": "node scripts/local-db.mjs",
    "db:stop": "node scripts/local-db.mjs --stop",
    "transfer:export": "node scripts/transfer.mjs export",
    "transfer:inspect": "node scripts/transfer.mjs inspect",
    "transfer:restore": "node scripts/transfer.mjs restore",
    "maintenance": "node --env-file=.env.local scripts/maintenance.mjs",
    "retention": "node --env-file=.env.local scripts/retention.mjs",
    "format": "prettier --write src tests scripts *.ts *.mjs *.json docs/*.md README.md"
  },
  "dependencies": {
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  }
}
